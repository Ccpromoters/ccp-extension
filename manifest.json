{
  "manifest_version": 3,
  "name": "CCP Extension - Job Search Assistant",
  "short_name": "CCP Extension",
  "version": "1.1.0",
  "description": "Opens your job boards, tracks applications from Gmail and history, and tailors your resume to any job description - everything stays in your browser.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CCP Extension",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "options_page": "src/options.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "history",
    "sidePanel",
    "downloads",
    "contextMenus",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.indeed.com/*",
    "https://*.ziprecruiter.com/*",
    "https://*.dice.com/*",
    "https://*.monster.com/*",
    "https://*.glassdoor.com/*",
    "https://mail.google.com/*",
    "https://api.anthropic.com/*",
    "https://*.insforge.app/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/jobs/*",
        "https://*.indeed.com/*",
        "https://*.ziprecruiter.com/*",
        "https://*.dice.com/*",
        "https://*.monster.com/*",
        "https://*.glassdoor.com/*"
      ],
      "js": ["src/content/jobpage.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["src/content/gmail.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/jobs-tracker/*", "https://www.linkedin.com/my-items/*", "https://myjobs.indeed.com/*"],
      "js": ["src/content/applied.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://boards.greenhouse.io/*", "https://job-boards.greenhouse.io/*", "https://jobs.lever.co/*", "https://apply.workable.com/*",
        "https://jobs.ashbyhq.com/*", "https://jobs.smartrecruiters.com/*", "https://*.myworkdayjobs.com/*", "https://*.ultipro.com/*",
        "https://*.ukg.net/*", "https://recruiting.paylocity.com/*", "https://*.icims.com/*", "https://*.taleo.net/*",
        "https://*.bamboohr.com/*", "https://jobs.jobvite.com/*", "https://*.successfactors.com/*", "https://*.applytojob.com/*"
      ],
      "js": ["src/content/apply.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Open CCP Extension"
    }
  }
}
